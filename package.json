{
  "name": "diffscribe-workbench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "diffscribe": "./src/bin/diffscribe.js"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || true && husky",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --max-warnings=0 --fix",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:bdd": "vitest run --config vitest.bdd.config.ts",
    "test:e2e": "playwright test",
    "qa": "npm run format && npm run lint && npm run check && npm run test:unit && npm run test:integration && npm run test:bdd && npm run test:e2e && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.55.0",
    "@sveltejs/adapter-node": "^5.2.10",
    "@sveltejs/kit": "^2.20.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@types/node": "^22.15.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.0",
    "eslint-plugin-import-x": "^4.11.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-svelte": "^3.6.0",
    "eslint-plugin-unused-imports": "^4.1.4",
    "globals": "^16.1.0",
    "husky": "^9.1.7",
    "prettier": "^3.5.2",
    "prettier-plugin-svelte": "^4.0.0-next.1",
    "quickpickle": "^1.11.2",
    "svelte": "^5.25.0",
    "svelte-check": "^4.1.5",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.65.0",
    "vite": "^6.3.0",
    "vitest": "^4.0.0"
  },
  "overrides": {
    "uuid": ">=11.1.1",
    "cookie": ">=0.7.0 <1.0.0"
  }
}
